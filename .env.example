# Default Base URL for the embed playground iframe.
# Copy this file to .env.local and adjust as needed.
NEXT_PUBLIC_EMBED_BASE_URL=http://localhost:3000/embed

# Offers API used to fetch the list of supported crypto/fiat pairs for the dropdowns.
# Leave unset to use the prod default (https://offers-y5u4f.ondigitalocean.app/api/v1).
NEXT_PUBLIC_OFFERS_API=https://offers-y5u4f.ondigitalocean.app/api/v1
